{
  "name": "skill-gap-analyzer",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack Skill Gap Analyzer — Next.js 15, TypeScript, Tailwind CSS v4. No login, no required database: Prisma/PostgreSQL is optional, only for saved history and company management.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "formidable": "^3.5.4",
    "mammoth": "^1.12.3",
    "next": "^15.1.6",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/formidable": "^3.5.1",
    "@types/node": "^22.10.7",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "dotenv": "^16.4.7",
    "postcss": "^8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
